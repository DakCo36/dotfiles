{
  "//": "Based on oh-my-posh theme: emodipt-extend.omp.json (https://github.com/JanDeDobbeleer/oh-my-posh/blob/main/themes/emodipt-extend.omp.json)",
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#E5C07B",
          "options": {
            "time_format": "15:04:05"
          },
          "style": "plain",
          "template": "[{{ .CurrentDate | date .Format }}]",
          "type": "time"
        },
        {
          "type": "shell",
          "style": "plain",
          "foreground": "#E06C75",
          "options": {
            "mapped_shell_names": {
              "pwsh": "Pwsh",
              "powershell": "Shell",
              "cmd": "Cmd",
              "bash": "Bash",
              "zsh": "Zsh"
            }
          },
          "template": " \ue795 {{ .Name }}"
        },
        {
          "type": "git",
          "style": "plain",
          "foreground": "#F3C267",
          "foreground_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FF9248{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}#ff4500{{ end }}",
            "{{ if gt .Ahead 0 }}#B388FF{{ end }}",
            "{{ if gt .Behind 0 }}#B388FF{{ end }}"
          ],
          "options": {
            "branch_template": "{{ trunc 25 .Branch }}"
          },
          "template": " {{ if .UpstreamIcon }}{{ .UpstreamIcon }} {{ end }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }} \uf044{{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }} \uf046{{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }} \ueb4b{{ .StashCount }}{{ end }} "
        },
        {
          "type": "project",
          "style": "plain",
          "foreground": "#F3C267",
          "template": "{{ if .Version }}({{ .Version }}) {{ end }}"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "segments": [
        {
          "type": "status",
          "style": "plain",
          "foreground": "#b8ff75",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#E06C75{{ end }}"
          ],
          "template": " {{ reason .Code }}({{ .Code }})"
        },
        {
          "foreground": "#b8ff75",
          "foreground_templates": [
            "{{ if gt .Code 0 }}#E06C75{{ end }}"
          ],
          "options": {
            "style": "houston",
            "always_enabled": true
          },
          "style": "plain",
          "template": " {{ .FormattedMs }} ",
          "type": "executiontime"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#61AFEF",
          "options": {
            "style": "full"
          },
          "style": "plain",
          "template": "\ue5ff {{ .Path }}",
          "type": "path"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "overflow": "break",
      "segments": [
        {
          "type": "node",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#FFFFFF",
          "background": "#6CA35E",
          "template": " \ue718 {{ if .Full }}{{ .Full }}{{ end }} "
        },
        {
          "type": "npm",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#FFFFFF",
          "background": "#6CA35E",
          "template": "\ue71e {{ if .Full }}{{ .Full }}{{ end }} "
        },
        {
          "type": "pnpm",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#FFFFFF",
          "background": "#6CA35E",
          "template": "\ue865 {{ if .Full }}{{ .Full }}{{ end }} "
        },
        {
          "type": "ruby",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#FFFFFF",
          "background": "#CC342D",
          "template": " \ue739 {{ if .Full }}{{ .Full }}{{ end }} "
        },
        {
          "type": "python",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#FFFFFF",
          "background": "#B8860B",
          "options": {
            "display_mode": "files",
            "extensions": [],
            "folders": [
              ".venv",
              "venv"
            ]
          },
          "template": " \ue235 {{ .Full }} "
        },
        {
          "type": "language",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#FFFFFF",
          "background": "#B8860B",
          "template": "uv {{ .Full }} ",
          "options": {
            "name": "uv",
            "extensions": [
              "pyproject.toml",
              "uv.lock",
              "*.py"
            ],
            "tools": [
              {
                "name": "uv",
                "executable": "uv",
                "args": [
                  "--version"
                ],
                "regex": "uv (?P<version>(?P<major>[0-9]+)\\.(?P<minor>[0-9]+)\\.(?P<patch>[0-9]+))"
              }
            ]
          }
        },
        {
          "type": "go",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#FFFFFF",
          "background": "#00ADD8",
          "template": " \ue627 {{ .Full }} "
        },
        {
          "type": "rust",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#FFFFFF",
          "background": "#B7410E",
          "template": " \ud83e\udd80 {{ .Full }} "
        },
        {
          "type": "java",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#FFFFFF",
          "background": "#5382A1",
          "template": " \ue256 {{ .Full }} "
        },
        {
          "type": "kotlin",
          "style": "powerline",
          "powerline_symbol": "\ue0b2",
          "invert_powerline": true,
          "foreground": "#FFFFFF",
          "background": "#5382A1",
          "template": " \ue634 {{ .Full }} "
        },
        {
          "type": "kubectl",
          "style": "plain",
          "foreground": "#326CE5",
          "template": " \udb84\udcfe {{ .Context }}{{ if .Namespace }} :: {{ .Namespace }}{{ end }} "
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#E06C75",
          "style": "plain",
          "template": "!",
          "type": "root"
        },
        {
          "foreground": "#E06C75",
          "style": "plain",
          "template": "\u276f",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}